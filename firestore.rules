rules_version = '2';

// Safar Firestore rules.
// Model: clients READ what they're a member of and WRITE only a few
// user-owned things. Everything else (creating trips, joining, AI results,
// halal verdicts) is written by the server (/api) with the Admin SDK,
// which bypasses these rules. Paths mirror src/domain/paths.ts.
// Deploy: npm run deploy:rules · Test: npm run test:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(tripId) {
      return signedIn()
        && exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid));
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ─── User profiles ───────────────────────────────────────────────
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.createdAt is int;
      allow update: if signedIn() && request.auth.uid == uid
        && onlyChanges(['displayName', 'photoURL'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 100;
      allow delete: if false;
    }

    // ─── Trips ───────────────────────────────────────────────────────
    match /trips/{tripId} {
      // Checked against the doc itself so "my trips" queries
      // (where memberIds array-contains uid) are allowed without extra reads.
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow write: if false; // server only

      match /members/{uid} {
        allow read: if isMember(tripId);
        // Members may edit their own travel preferences, nothing else.
        allow update: if signedIn() && request.auth.uid == uid
          && onlyChanges(['prefs'])
          && request.resource.data.prefs is map;
        allow create, delete: if false; // server only (join / remove / leave)
      }

      // Everything else under a trip: readable by members, server-written.
      // Later phases open specific client writes here (votes, expenses, …).
      match /{sub=**} {
        allow read: if isMember(tripId);
        allow write: if false;
      }
    }

    // ─── Invite tokens (server only; looked up via /api/invites/*) ───
    match /inviteTokens/{token} {
      allow read, write: if false;
    }

    // ─── Worldwide halal knowledge (shared across all trips) ─────────
    match /halalSummary/{placeKey} {
      allow read: if signedIn();
      allow write: if false; // server aggregates reports
    }
    match /certifiers/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Anything not matched above is denied.
  }
}
