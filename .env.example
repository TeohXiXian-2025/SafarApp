# ============================================================================
# Safar — environment template (committed). Copy to .env.local and fill in.
# VITE_*  = sent to the browser;  others = server only (Vercel /api).
# ============================================================================


# ─── 1. FIREBASE (required, Phase 0) ────────────────────────────────────────
# Firebase console → ⚙ Project settings → General → Your apps → Web app (</>)
# → "SDK setup and configuration" → Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase console → ⚙ Project settings → Service accounts
# → "Generate new private key" (downloads a .json file).
# Convert the whole JSON file to ONE base64 line, then paste it here:
#   PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\path\to\key.json"))
#   Git Bash:    base64 -w0 /c/path/to/key.json
# Then delete the downloaded .json file.
FIREBASE_SERVICE_ACCOUNT=


# ─── 2. GOOGLE MAPS PLATFORM (required, Phase 0) ────────────────────────────
# Google Cloud console → APIs & Services → Credentials → Create API key.
# Enable APIs: Maps JavaScript API, Places API (New), Routes API, Time Zone API.

# Browser key — Application restriction: HTTP referrers
#   http://localhost:5173/*  and  https://<your-vercel-domain>/*
# API restriction: Maps JavaScript API, Places API (New)
VITE_GOOGLE_MAPS_API_KEY=

# (Optional) Map ID for styled/vector maps: Google Cloud → Map Management
VITE_GOOGLE_MAPS_MAP_ID=

# Server key — Application restriction: None
# API restriction: Places API (New), Routes API, Time Zone API
GOOGLE_MAPS_SERVER_KEY=


# ─── 3. GEMINI AI (required, Phase 3) ───────────────────────────────────────
# https://aistudio.google.com → Get API key
GEMINI_API_KEY=

# ─── 3b. GROQ (free backup AI, used when Gemini's free quota runs out) ───────
# https://console.groq.com → API Keys → Create API Key  (free, no card)
# Text jobs use openai/gpt-oss-120b; screenshots/photos use qwen/qwen3.8-27b.
GROQ_API_KEY=


# ─── 4. HOTELS (Phase 8) ────────────────────────────────────────────────────
# Main source: Google Hotels through SerpApi — real hotels, live prices for the
# exact dates, and each booking site's price + link (Agoda, Booking.com, …).
# https://serpapi.com → Dashboard → API key (free plan: 250 searches / month)
SERPAPI_KEY=
# Safar stops using SerpApi after this many searches in a calendar month (keeps
# a margin under the free 250). Each hotel search is cached 24 h per stay.
SERPAPI_MONTHLY_CAP=200

# Fallback when the SerpApi cap is reached: LiteAPI. The free SANDBOX key gives
# real hotels but test prices (shown as "sample price").
# https://dashboard.liteapi.travel → Profile → API keys
LITEAPI_KEY=


# ─── 5. HALAL DATA (optional, Phase 4) ──────────────────────────────────────
# https://halalbites.co/api
FOURSQUARE_API_KEY=

# ─── 5b. SOCIAL POST READERS (free credits; used only when a pasted link's
# caption isn't enough). Leave empty to use only the free built-in readers.
# Apify — Xiaohongshu notes (all images). Free plan renews $5/month, no card:
#   https://console.apify.com → Settings → API & Integrations → Personal API token
APIFY_TOKEN=
# ScrapeCreators — Instagram & TikTok posts (all carousel images, video).
#   https://app.scrapecreators.com → API key  (100 free credits; claim more free)
SCRAPECREATORS_API_KEY=
# Safety caps per calendar month so free credits never run out by surprise.
APIFY_MONTHLY_CAP=600
SCRAPECREATORS_MONTHLY_CAP=500


# ─── 6. FLIGHT STATUS for Emergency Resync (optional, Phase 9) ──────────────
# https://aviationstack.com → Dashboard → API access key (free: 100 calls/mo).
# The reminders job checks flights leaving within 6 h (each at most every 2 h)
# and raises a report for the admin on a 30+ min delay or a cancellation.
# Without it, travellers report delays themselves from the flight's card.
FLIGHT_STATUS_API_KEY=
# Stop calling AviationStack after this many calls in a calendar month.
FLIGHT_STATUS_MONTHLY_CAP=90


# ─── 7. MONITORING & RATE LIMITING (optional, Phase 10) ─────────────────────
# https://sentry.io → Project → Client Keys (DSN)
VITE_SENTRY_DSN=

# https://upstash.com → Redis database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ─── 7b. PUSH NOTIFICATIONS + REMINDERS (optional) ───────────────────────────
# Standard Web Push — no Firebase Cloud Messaging setup. Generate a key pair once:
#   node -e "const k=require('web-push').generateVAPIDKeys();console.log(k)"
# Keep the SAME pair forever: changing it silently breaks every device that
# already turned notifications on (they must turn them on again).
# Also add all three to Vercel → Settings → Environment Variables (Production).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Protects GET/POST /api/cron/reminders (closes overdue votes, 12 h reminders).
# Vercel Cron sends it automatically; an Upstash QStash schedule must send it as
# "Authorization: Bearer <CRON_SECRET>". Generate one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=
# (Optional) Upstash QStash — an hourly schedule calling /api/cron/reminders
# gives exact "12 h left" reminders (Vercel Cron alone runs once a day).
# Only needed to create/manage the schedule; the app never reads these.
#   console.upstash.com → QStash → pick a region (US if your Vercel functions run
#   in the US) → copy QSTASH_URL and QSTASH_TOKEN. Rotate the token if it leaks.
QSTASH_URL=
QSTASH_TOKEN=


# ─── 8. APP ─────────────────────────────────────────────────────────────────
# Public URL of the app (used for invite links). Change to your Vercel domain.
APP_URL=http://localhost:5173

# No keys needed: Aladhan (prayer times), Open-Meteo (weather),
# OpenStreetMap Overpass (mosques / diet:halal), Frankfurter (currency).

# Full Halal Radar checks per month, all trips (each reads Google reviews: ~1,000
# free a month, then about US$20–40 per 1,000). Default 900 stays in the free tier.
HALAL_CHECKS_PER_MONTH=900


# ─── 9. BACKUP PLACE / PHOTO / ROUTE SOURCES (when Google says no) ──────────
# Safar asks Google first; when Google refuses (quota, error) or Safar's own
# daily Google budget below is used up, the next source answers instead — real
# places, credited ("via OpenStreetMap"). Everything found is remembered in
# Firestore (knownPlaces) so an outage never shows an empty screen.
#
#   Mosques / prayer rooms, cafés, indoor places, stations:
#     Google → Geoapify → OpenStreetMap Overpass (no key) → remembered places
#   Halal restaurants:
#     Google → Geoapify (halal filter) → Overpass diet:halal (no key) → remembered
#   Place photos:
#     Google (monthly cap) → Wikipedia / Wikimedia (no key) → Mapillary → map preview
#   Travel times:
#     Google Routes → openrouteservice (walking / road) → distance estimate
#   Search box (browser):
#     Google Autocomplete → Photon / OpenStreetMap (no key)

# Geoapify Places (OpenStreetMap-based, has a halal filter). Free: 3,000 credits/day.
#   myprojects.geoapify.com → sign up → create a project → copy the API key.
GEOAPIFY_API_KEY=
# openrouteservice (walking / driving times). Free: 2,000 directions/day.
#   openrouteservice.org/dev/#/signup → Dashboard → Tokens → "Free" → copy the key.
OPENROUTESERVICE_API_KEY=
# (Optional) Mapillary street-level photos for places without a Wikipedia photo. Free.
#   mapillary.com/dashboard/developers → Register application (read access) →
#   copy the "Client Token" (starts with MLY|).
MAPILLARY_TOKEN=

# Safar's own daily Google budget per kind of request (app-wide). Past it, the
# backup sources above answer, before Google would bill or refuse. Keep each
# at or below the daily quota you set in Google Cloud → APIs & Services →
# Places API (New) / Routes API → Quotas.
GOOGLE_DAILY_NEARBY=250
GOOGLE_DAILY_TEXT=120
GOOGLE_DAILY_ROUTES=250
# Google place photos per month (each is a billed "Place Details Photos" request).
GOOGLE_PHOTOS_MONTHLY_CAP=800
