{
  "entities": {
    "Itinerary": {
      "title": "Itinerary",
      "description": "Collaborative trip itinerary containing destination, metadata, and prayer settings.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "subtitle": { "type": "string", "maxLength": 300 },
        "destination": { "type": "string", "maxLength": 150 },
        "dateRange": { "type": "string", "maxLength": 100 },
        "lastEditedSlot": { "type": "string", "maxLength": 100 },
        "lastEditedBy": { "type": "string", "maxLength": 100 },
        "lastEditedAt": { "type": "string", "maxLength": 60 },
        "createdAt": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "title"]
    },
    "ActivityBlock": {
      "title": "ActivityBlock",
      "description": "An itinerary item or Split & Sync block on the timeline.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "itineraryId": { "type": "string", "maxLength": 128 },
        "dayId": { "type": "string", "maxLength": 64 },
        "time": { "type": "string", "maxLength": 30 },
        "title": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "maxLength": 50 },
        "duration": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 1000 },
        "location": { "type": "string", "maxLength": 200 },
        "isSplitSync": { "type": "boolean" },
        "updatedBy": { "type": "string", "maxLength": 100 },
        "updatedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "time", "title"]
    },
    "TimelineClash": {
      "title": "TimelineClash",
      "description": "Detected conflict when two tripmates propose overlapping afternoon activities.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "itineraryId": { "type": "string", "maxLength": 128 },
        "slotTime": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 30 },
        "detectedAt": { "type": "string", "maxLength": 60 },
        "initiator1": { "type": "string", "maxLength": 100 },
        "initiator2": { "type": "string", "maxLength": 100 },
        "impactText": { "type": "string", "maxLength": 200 },
        "totalVotes": { "type": "number" },
        "votedCount": { "type": "number" }
      },
      "required": ["id", "slotTime", "status"]
    },
    "AnonymousVote": {
      "title": "AnonymousVote",
      "description": "Secure anonymous vote submitted for AI compromise options without exposing user identity.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "clashId": { "type": "string", "maxLength": 128 },
        "selectedOptionId": { "type": "string", "maxLength": 100 },
        "voterHash": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "clashId", "selectedOptionId"]
    }
  },
  "firestore": {
    "/itineraries/{itineraryId}": {
      "schema": { "$ref": "Itinerary" },
      "description": "Trips planned within Safar OS"
    },
    "/itineraries/{itineraryId}/blocks/{blockId}": {
      "schema": { "$ref": "ActivityBlock" },
      "description": "Activity blocks and Split & Sync blocks on the itinerary"
    },
    "/clashes/{clashId}": {
      "schema": { "$ref": "TimelineClash" },
      "description": "Active conflict records managed by the Safar AI Mediator"
    },
    "/clashes/{clashId}/votes/{voteId}": {
      "schema": { "$ref": "AnonymousVote" },
      "description": "Anonymous votes recorded for clash resolution without identity exposure"
    }
  }
}
