rules_version = '2';

// Safar Storage rules. Paths mirror storagePaths in src/domain/paths.ts.
// Deploy: npm run deploy:rules
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // A traveller's own uploads for a trip: tickets, post screenshots/recording
    // frames, recording audio (vault documents later).
    // Private to the uploader; the server reads them with the Admin SDK and
    // checks trip membership before using them.
    match /trips/{tripId}/users/{uid}/{allPaths=**} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp|heic|heif)|audio/(wav|x-wav|webm|mp4|m4a|mpeg|ogg)');
      allow update: if false;
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
