rules_version = '2';

// Safar Storage rules. Uploads start in Phase 3 (tickets, vault, halal
// evidence); until then nothing is readable or writable from clients.
// Deploy: npm run deploy:rules
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
